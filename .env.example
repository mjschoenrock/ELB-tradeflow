# Image overrides (optional). For local development, compose builds local images.
# BACKEND_IMAGE=ghcr.io/your-org/tradeflow-backend:latest
# FRONTEND_IMAGE=ghcr.io/your-org/tradeflow-frontend:latest
# For the final demo, pin to a specific SHA instead of :latest.
# BACKEND_IMAGE=ghcr.io/your-org/tradeflow-backend:<sha>
# FRONTEND_IMAGE=ghcr.io/your-org/tradeflow-frontend:<sha>

POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow_user
POSTGRES_PASSWORD=changeme

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Standard Day 10 localhost ports.
KAFKA_HOST_PORT=9092

# Host port mappings for the Day 10 stack.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
KAFDROP_HOST_PORT=9000
